{
  "name": "ai-website-clone-template",
  "version": "0.6.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "node scripts/start-playwright-server.mjs",
    "test:e2e": "node node_modules/next/dist/bin/next build && node node_modules/@playwright/test/cli.js test",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pipeline:doctor": "node scripts/codex-pipeline.mjs doctor",
    "pipeline:test": "node --test scripts/codex-pipeline.test.mjs",
    "pipeline:quality": "node scripts/codex-pipeline.mjs quality",
    "verify": "node scripts/codex-pipeline.mjs verify",
    "check": "node scripts/codex-pipeline.mjs verify",
    "codex:npm": "node scripts/codex-npm.mjs",
    "research:day": "node scripts/codex-pipeline.mjs research:init",
    "research:verify": "node scripts/codex-pipeline.mjs research:verify",
    "evidence:init": "node scripts/codex-pipeline.mjs evidence:init",
    "evidence:verify": "node scripts/codex-pipeline.mjs evidence:verify",
    "evidence:audit": "node scripts/codex-pipeline.mjs evidence:audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:wasm",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:asm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-asm.ps1",
    "build:native": "npm run build:wasm && npm run build:asm",
    "sync:skills": "npm run build:wasm && node scripts/sync-skills-host.mjs",
    "sync:rules": "npm run build:wasm && node scripts/sync-rules-host.mjs",
    "sync:skills:pe": "bin\\sync-skills.exe",
    "sync:rules:pe": "bin\\sync-agent-rules.exe",
    "sync:skills:js": "node scripts/sync-skills.mjs",
    "sync:rules:sh": "bash scripts/sync-agent-rules.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wabt": "^1.0.39"
  }
}

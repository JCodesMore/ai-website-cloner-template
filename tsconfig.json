{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-verify2/types/**/*.ts",
    ".next-verify2/dev/types/**/*.ts",
    ".next-verify3/types/**/*.ts",
    ".next-verify3/dev/types/**/*.ts",
    ".next-open/types/**/*.ts",
    ".next-open/dev/types/**/*.ts",
    ".next-dev-b/types/**/*.ts",
    ".next-dev-b/dev/types/**/*.ts",
    ".next-dev-c/types/**/*.ts",
    ".next-dev-c/dev/types/**/*.ts",
    ".next-build-verify/types/**/*.ts",
    ".next-build-verify/dev/types/**/*.ts",
    ".next-dev-d/types/**/*.ts",
    ".next-dev-d/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
